<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.kbeauty</groupId>
    <artifactId>ai-core-service</artifactId>
    <version>1.0.0</version>
    <name>ai-core-service</name>
    <description>Moteur IA semantique et RAG pour boutique e-commerce</description>
    <properties>
        <java.version>25</java.version>
        <sonar.projectKey>NF31_kbeauty-ai-core-service</sonar.projectKey>
        <sonar.organization>nf31</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.12</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <!-- Validation des evenements RabbitMQ contre contracts/rabbitmq/*.schema.json
                 avant publication (Axe 1 - contrat de donnees, voir kbeauty-shop/docs/montee-competence/07-axes-hors-programme.md) -->
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.6</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Base embarquee pour @DataJpaTest (DiagnosticRequestRepositoryTest) :
                 aucune config a fournir, Spring Boot detecte h2 sur le classpath
                 et remplace automatiquement le datasource Postgres par une base
                 en memoire le temps du test - jamais de connexion a Neon depuis
                 les tests. -->
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Circuit breaker + retry sur l'appel a l'API Anthropic (Axe 2
                 hors programme, voir kbeauty-shop/docs/montee-competence/07-axes-hors-programme.md) -->
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.4.0</version>
        </dependency>
        <dependency>
            <!-- Requis pour que Spring proxy (AOP) les methodes annotees
                 @CircuitBreaker/@Retry - sans ce starter, les annotations
                 sont silencieusement ignorees. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <!-- Rend contracts/rabbitmq/*.schema.json chargeable via le classpath
                     (DiagnosticCreatedEventSchemaValidator) sans dupliquer le fichier
                     dans src/main/resources - une seule copie source cote ce repo. -->
                <directory>contracts</directory>
                <targetPath>contracts</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!-- Sans ce plugin, `mvn package` ne produit qu'un jar "thin" (les
                     classes du projet seules, sans les dependances) - inutilisable
                     en `java -jar` standalone (ex. Azure App Service). Le goal
                     `repackage` genere le jar executable Spring Boot (classes +
                     dependances + manifest Main-Class). -->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>4.0.0.4121</version>
            </plugin>
        </plugins>
    </build>
</project>
